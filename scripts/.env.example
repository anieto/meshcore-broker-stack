# Copy to .env and fill in NTFY_TOKEN before deploying.
# .env is gitignored — never commit it.

# ntfy push (used by backup-and-update.sh). NTFY_URL can point at the public
# https://ntfy.sh or a self-hosted ntfy server. Topic is just a name; the
# token authorizes publishing. Leave NTFY_TOKEN blank to disable notifications.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=meshcore-alerts
NTFY_TOKEN=

# Cloudflare API Token used by backup-and-update.sh to export the
# meshtexas-repeaters D1 database. Create at Cloudflare dashboard -> My
# Profile -> API Tokens -> Create Token (custom token, permission
# "Account > D1 > Edit", scoped to this account only). Leave blank to
# skip the D1 export step.
CLOUDFLARE_API_TOKEN=
